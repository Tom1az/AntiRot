# Copy file này thành .env rồi điền giá trị thật:
#   cp .env.example .env

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/antirot

# JWT auth
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# Dual-agent chat (optional — local Ollama)
AGENT1_BASE_URL=http://localhost:11434
AGENT1_MODEL_NAME=socratic-coach
AGENT2_MAX_RETRIES=1

# Optional: tuned Gemini model name
# TUNED_MODEL_NAME=

# CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000